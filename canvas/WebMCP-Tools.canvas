		{"id":"85c635aa247b44d0","type":"text","text":"1️⃣ **add_plant**\nin: name, species, location\n→ new card appears","x":-900,"y":-420,"width":340,"height":150,"color":"4"},
		{"id":"96717a0949854f70","type":"text","text":"2️⃣ **get_care_schedule**\nin: plant_id?, days_ahead?\n→ sorted due list","x":-520,"y":-420,"width":340,"height":150,"color":"4"},
		{"id":"e1f66e1899694db7","type":"text","text":"3️⃣ **get_watering_forecast** ⭐\nin: latitude, longitude\n→ SKIP/WATER per outdoor plant\n(uses Open-Meteo real rain)","x":-140,"y":-420,"width":340,"height":150,"color":"2"},
		{"id":"6ee641c083f74366","type":"text","text":"4️⃣ **diagnose_problem**\nin: plant_id, symptoms[]\n→ ranked causes + evidence\n(uses care HISTORY)","x":240,"y":-420,"width":340,"height":150,"color":"3"},
		{"id":"c5e419390d604c8d","type":"text","text":"5️⃣ **log_care_activity**\nin: plant_id, activity\n→ countdown resets, badge −1","x":-900,"y":300,"width":340,"height":150,"color":"6"},
		{"id":"fc540d0cd39647ca","type":"text","text":"6️⃣ **plan_seasonal_planting**\nin: lat, long, crops[]\n→ planting calendar","x":-520,"y":300,"width":340,"height":150,"color":"6"},
		{"id":"685c233b6cba40a9","type":"text","text":"7️⃣ **log_growth**\nin: plant_id, milestone\n→ journal timeline","x":-140,"y":300,"width":340,"height":150,"color":"6"},
